<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mackenzie Evans</title>
<meta name="description" content="Mackenzie Evans — journalism student, writer, and data storyteller in Lincoln, NE.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #15151c;
    --panel: #18181c;
    --border: #38383c;
    --ink: #e5e5ec;
    --muted: #c8c8cc;
    --accent: #e7e7ec;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
  }
  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.6;
  }
  h1, h2, h3 {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 700;
    color: var(--ink);
  }
  a { color: var(--ink); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 56px 24px 80px; }

  header.hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 48px;
  }
  header.hero h1 { font-size: clamp(2rem, 6vw, 2.8rem); margin: 0; letter-spacing: -0.01em; }
  header.hero .tagline { font-size: 1.05rem; color: var(--muted); margin: 0; }
  header.hero .location { font-size: 0.9rem; color: var(--muted); margin: 0; }

  nav.links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  nav.links a {
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 0.85rem;
    color: var(--ink);
    transition: border-color .15s ease, background .15s ease;
  }
  nav.links a:hover { border-color: var(--accent); background: var(--panel); }

  section { margin-bottom: 48px; }
  section h2 {
    font-size: 1.3rem;
    margin: 0 0 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  p.lead { color: var(--ink); font-size: 1rem; }

  .entry { margin-bottom: 26px; }
  .entry:last-child { margin-bottom: 0; }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .entry-title { font-weight: 600; font-size: 1.02rem; color: var(--ink); }
  .entry-org { color: var(--muted); font-size: 0.92rem; }
  .entry-date { color: var(--muted); font-size: 0.85rem; white-space: nowrap; }
  .entry ul {
    margin: 10px 0 0;
    padding-left: 20px;
    color: var(--muted);
  }

.entry li { margin-bottom: 5px; font-size: 0.95rem; }
  .entry li::marker { color: var(--border); }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .skill-group h3 {
    font-size: 0.95rem;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .skill-group p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .projects-grid {
    display: grid;
    gap: 14px;
  }
  .project-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    text-decoration: none;
    background: var(--panel);
    transition: border-color .15s ease;
  }
 .project-card:hover { border-color: var(--accent); }
  .project-card .p-title { font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .project-card .p-desc { color: var(--muted); font-size: 0.9rem; }

  footer {
    color: var(--muted);
    font-size: 0.82rem;
    border-top: 1px solid var(--border);
    padding-top: 20px;
    margin-top: 16px;
  }
</style>

</head>
<body>

<div class="wrap">
</div>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>
</body>
</html>

